# ==============================================================================
# Codeacious AI Engineering Intern: Personalized AI Journal (RAG MVP)
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- Application Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Security & JWT Authentication ---
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase Database & Vector Store ---
# Get these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key to allow the backend to bypass RLS and execute multi-tenant verified queries
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- AI Provider Configuration (Ollama vs OpenRouter Toggle) ---
# Choose: "openrouter" or "ollama"
LLM_PROVIDER=openrouter

# [Option A: OpenRouter (Cloud)]
# When LLM_PROVIDER=openrouter:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# [Option B: Ollama (Local)]
# When LLM_PROVIDER=ollama:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2

# --- Embedding Model Configuration ---
# Choose: "fastembed" (local zero-cost CPU model, 384 dims) or "openai" (cloud, 1536 dims)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Optional: If EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
